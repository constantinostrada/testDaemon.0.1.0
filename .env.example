# =============================================================================
# Mini-Library API — Environment Variables
# Copy to .env and fill in values:  cp .env.example .env
# =============================================================================

# Application
APP_ENV=development
APP_TITLE="Mini-Library API"
APP_VERSION=0.1.0
LOG_LEVEL=info

# Database
DATABASE_URL=./library.db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
